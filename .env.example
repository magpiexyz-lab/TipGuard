# TipGuard — environment variables
#
# Copy to `.env.local` for local development. In production these are set in
# the hosting platform (Vercel → Project → Settings → Environment Variables).
# `/deploy` provisions most of them for you.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle. Everything without
# that prefix is server-only and MUST NOT be exposed to the client.

# --- Site (framework/nextjs, hosting/vercel) -------------------------------
# Canonical public origin. Used for Stripe redirect URLs, signing-link emails,
# and metadataBase. Without it, checkout redirects become "undefined/dashboard".
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Database + Auth (database/supabase, auth/supabase) --------------------
# Auto-injected by the Supabase Vercel Integration (vercel.com/integrations/supabase).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# In the Supabase dashboard this is the "Publishable Key" (new keys: sb_publishable_...).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-api-key
# SERVER ONLY. Bypasses RLS — never expose to the client, never prefix NEXT_PUBLIC_.
# Every mutation route in this app uses it, so the app is read-only without it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Set by the Supabase Vercel Integration. Drives `prebuild` auto-migration.
POSTGRES_URL_NON_POOLING=postgres://...

# --- Auth providers (auth/supabase) ----------------------------------------
# Google sign-in is fully implemented but the button only renders when this is
# "true". Turning it on without ALSO enabling Google on the Supabase project
# gives users a button that 400s with "provider is not enabled".
# Order: create the Google Cloud OAuth client (callback
# https://<ref>.supabase.co/auth/v1/callback) -> enable Google under Supabase
# Authentication -> Sign In / Providers -> set this to "true" -> redeploy.
NEXT_PUBLIC_GOOGLE_SIGN_IN_ENABLED=

# --- Analytics (analytics/posthog) -----------------------------------------
# Replace the phc_TEAM_KEY placeholder or events silently never send.
# `scripts/check-analytics-env.mjs` fails the build on Vercel if it is missing.
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
# Optional server-side key. Falls back to NEXT_PUBLIC_POSTHOG_KEY when unset.
POSTHOG_SERVER_KEY=

# --- Email (email/resend) ---------------------------------------------------
# Employee signing-link emails (b-06) and the post-checkout welcome (b-11).
RESEND_API_KEY=re_...
# Verified sender. Defaults to onboarding@resend.dev when unset.
RESEND_FROM=notices@your-domain.com

# --- AI (ai/anthropic) ------------------------------------------------------
# Scoped to PROSE ONLY — plain-English violation explanations and notice
# wording polish. Rule resolution, scoring and violation detection are
# deterministic pure functions and never call the model.
ANTHROPIC_API_KEY=sk-ant-...

# --- Images (images/fal) ----------------------------------------------------
# AI image generation via fal.ai (optional -- SVG placeholders used if absent)
FAL_KEY=

# --- Testing (testing/playwright) -------------------------------------------
# Optional, defaults to 3099. Avoids conflicts with other services on port 3000.
E2E_PORT=3099
# Optional. Set to a production URL to test a deployment instead of a local dev
# server (skips the webServer block).
E2E_BASE_URL=
# Optional production test user. `/deploy` STATE 4 creates it and sets these.
PROD_TEST_EMAIL=
PROD_TEST_PASSWORD=

# --- Local development escape hatch ----------------------------------------
# Runs the app against mocked clients when no Supabase project is wired up.
# The app REFUSES to start in demo mode on Vercel (VERCEL === "1") — it is a
# local-only convenience, never a production configuration.
DEMO_MODE=
NEXT_PUBLIC_DEMO_MODE=
